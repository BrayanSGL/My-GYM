{
  "primitive": {
    "color": {
      "ink": {
        "950": "#0d0b16",
        "900": "#191623",
        "800": "#241f33",
        "700": "#332c47"
      },
      "slate": {
        "500": "#7b7594",
        "300": "#9d97b3",
        "100": "#cac5db"
      },
      "white": "#f7f5fb",
      "violet": {
        "500": "#7c3aed",
        "600": "#6d28d9"
      },
      "pink": {
        "500": "#ec4899",
        "600": "#db2777"
      },
      "red": {
        "500": "#ef4444"
      }
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px"
    },
    "radius": {
      "sm": "6px",
      "md": "10px",
      "lg": "16px",
      "full": "9999px"
    },
    "font": {
      "heading": "'Outfit', system-ui, sans-serif",
      "body": "'Work Sans', system-ui, sans-serif",
      "size": {
        "xs": "12px",
        "sm": "14px",
        "base": "16px",
        "lg": "18px",
        "xl": "22px",
        "2xl": "28px",
        "3xl": "36px"
      }
    }
  },
  "semantic": {
    "background": "{primitive.color.ink.950}",
    "surface": "{primitive.color.ink.900}",
    "surface-raised": "{primitive.color.ink.800}",
    "border": "{primitive.color.ink.700}",
    "text-primary": "{primitive.color.white}",
    "text-secondary": "{primitive.color.slate.100}",
    "text-muted": "{primitive.color.slate.300}",
    "accent-primary": "{primitive.color.violet.500}",
    "accent-primary-hover": "{primitive.color.violet.600}",
    "accent-secondary": "{primitive.color.pink.500}",
    "accent-secondary-hover": "{primitive.color.pink.600}",
    "danger": "{primitive.color.red.500}"
  },
  "component": {
    "button-primary": {
      "bg": "{semantic.accent-primary}",
      "bg-hover": "{semantic.accent-primary-hover}",
      "text": "{primitive.color.white}",
      "radius": "{primitive.radius.md}"
    },
    "button-secondary": {
      "bg": "{semantic.surface-raised}",
      "text": "{semantic.text-primary}",
      "border": "{semantic.border}",
      "radius": "{primitive.radius.md}"
    },
    "button-danger": {
      "bg": "{semantic.danger}",
      "text": "{primitive.color.white}",
      "radius": "{primitive.radius.md}"
    },
    "card": {
      "bg": "{semantic.surface}",
      "border": "{semantic.border}",
      "radius": "{primitive.radius.lg}",
      "padding": "{primitive.spacing.4}"
    },
    "input": {
      "bg": "{semantic.surface-raised}",
      "border": "{semantic.border}",
      "text": "{semantic.text-primary}",
      "radius": "{primitive.radius.md}"
    },
    "nav": {
      "bg": "{semantic.surface}",
      "border": "{semantic.border}",
      "active": "{semantic.accent-primary}",
      "inactive": "{semantic.text-muted}"
    },
    "badge": {
      "bg": "{semantic.surface-raised}",
      "text": "{semantic.text-secondary}",
      "radius": "{primitive.radius.full}"
    }
  }
}
